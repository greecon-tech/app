[Unit]
Description=Greecon edge agent (MQTT -> cloud API telemetry bridge)
After=network-online.target mosquitto.service
Wants=network-online.target
Requires=mosquitto.service

[Service]
Type=simple
# Readings the API could not take are kept here (JSON lines), so a restart or power cut during an
# outage does not lose them. StateDirectory creates /var/lib/greecon-edge owned by the service
# user. edge.env, loaded next, can override BUFFER_PATH.
StateDirectory=greecon-edge
Environment=BUFFER_PATH=/var/lib/greecon-edge/buffer.jsonl
EnvironmentFile=/etc/greecon/edge.env
WorkingDirectory=/opt/greecon/apps/edge-agent
ExecStart=/usr/bin/node /opt/greecon/apps/edge-agent/dist/index.js
Restart=always
RestartSec=5
User=greecon
Group=greecon
# RestartSec is short but not aggressive enough to thrash if the API is down for a while;
# nothing is lost by a restart because the backlog is on disk (BUFFER_PATH above).
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
