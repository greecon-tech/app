# Site-specific configuration for the edge box. Copy to /etc/greecon/edge.env and fill in the
# real values for this site — see docs/14-edge-hardware-deployment.md.
#
# Get SITE_ID from the platform's Admin page for this tenant (create the site there first if it
# doesn't exist yet). Get GATEWAY_ID and EDGE_TOKEN together from that same site's own page, using
# its "Add gateway" form — the secret it shows is EDGE_TOKEN below, shown exactly once, so copy it
# before leaving that screen. No more reading any of this out of Postgres by hand.

TENANT_ID=
SITE_ID=
GATEWAY_ID=

# Local broker on this same box — do not point this at a remote/public broker (see the Mosquitto
# config note in the deployment guide on why it's bound to loopback only).
MQTT_URL=mqtt://127.0.0.1:1883

# The cloud API's normal address for this deployment (its Railway/GCP URL).
API_URL=

# This gateway's own real device credential (docs/07-security-and-rbac.md) — generated once by the
# "Add gateway" form above, unique to this box, never shared with any other gateway or client. When
# set, the agent authenticates with this instead of API_ROLE/TENANT_ID below, and the API only
# accepts it on the telemetry-ingest path, scoped server-side to this gateway's own tenant. Leave
# unset only for local dev against a non-production API instance.
EDGE_TOKEN=

# Only used as a fallback when EDGE_TOKEN is unset (local dev) — the API rejects this header
# outright on a production deployment. Least-privileged role that still holds telemetry:ingest; do
# not use owner/admin here even for local testing.
API_ROLE=operator

# How often the agent retries anything buffered while the API was unreachable.
FLUSH_INTERVAL_MS=10000

# Where readings are kept while the API is unreachable, so a restart or power cut does not lose
# them. The systemd unit already sets this to /var/lib/greecon-edge/buffer.jsonl; uncomment only
# to move it. Oldest readings are discarded (and reported in the journal) beyond BUFFER_MAX_ITEMS.
# BUFFER_PATH=/var/lib/greecon-edge/buffer.jsonl
# BUFFER_MAX_ITEMS=50000

# Longest one request to the API may take before it counts as failed and is retried later.
# REQUEST_TIMEOUT_MS=10000
